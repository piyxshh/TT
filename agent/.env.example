# LiveKit — required (A-01) — LiveKit Inference handles STT/LLM/TTS via same LiveKit Cloud project
# No separate Deepgram/Groq/ElevenLabs/Cartesia keys needed.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=...
LIVEKIT_API_SECRET=...

# LiveKit Inference — optional overrides (defaults work out of the box, billed via LiveKit Cloud)
# See https://docs.livekit.io/agents/models/inference/ for all models
# STT: deepgram/nova-3, deepgram/flux-general, assemblyai/universal-3.5, etc.
INFERENCE_STT_MODEL=deepgram/nova-3
INFERENCE_STT_LANGUAGE=en
# LLM: openai/gpt-4.1-mini (recommended low-cost), google/gemma-4-31b-it (default), openai/gpt-4o, etc.
INFERENCE_LLM_MODEL=openai/gpt-4.1-mini
# TTS: cartesia/sonic-3, cartesia/sonic-3.5, inworld/inworld-tts-2, elevenlabs/eleven_flash_v2, etc.
INFERENCE_TTS_MODEL=cartesia/sonic-3
INFERENCE_TTS_VOICE=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc

# Interview — local dev fallback (PRD C-01). In production these come from LiveKit room metadata.
CANDIDATE_NAME=Aarav
JOB_TITLE=Backend Engineer
QUESTIONS_JSON=["Tell me about yourself.", "What is your Node.js experience?", "Describe a challenging bug you fixed."]
ROOM_NAME=taptalent-interview

# Backend — for transcript POST (optional; agent also writes transcripts/{id}.json locally)
BACKEND_URL=http://localhost:3000
BACKEND_INTERNAL_URL=http://localhost:3000

# Logging
LOG_LEVEL=INFO
